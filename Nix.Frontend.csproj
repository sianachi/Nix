<!--
  The frontend tree, surfaced inside the .NET solution.

  Nix.slnx sits at the repository root so that one IDE window covers both lanes.
  This project exists only so the frontend sources are browsable from that
  window. It compiles no C#, references nothing, and produces nothing anyone
  consumes - apps/ and packages/ are built by pnpm, never by MSBuild.

  It is a plain SDK project rather than a stub that opts out of restore: a
  project that answers "restore not supported" makes every solution-wide restore
  (so every backend CI run, and dotnet format as well) log NU1503, and that
  warning cannot be silenced from inside the project it names.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- A project at the repository root: the SDK's default globs would sweep
         every backend .cs file and the whole of node_modules. Items are listed
         by hand below instead. -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="apps/*/src/**/*" />
    <None Include="packages/*/src/**/*" />
  </ItemGroup>

</Project>
