{
  "name": "@nix/cli",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Nix CLI (nixctl): the scriptable, machine-readable way into a workspace without a browser",
  "bin": {
    "nixctl": "src/index.ts"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nix/api-client": "workspace:*",
    "@nix/companion": "workspace:*",
    "@nix/editor-schema": "workspace:*",
    "@nix/markdown": "workspace:*",
    "@nix/structure-spec": "workspace:*",
    "@openuidev/lang-core": "1.0.1",
    "commander": "^14.0.2",
    "lib0": "^0.2.119",
    "prosemirror-model": "^1.25.12",
    "ws": "^8.22.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.2",
    "msw": "^2.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
