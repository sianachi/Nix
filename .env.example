# Nix development environment.
#
# Every variable below already has the same default baked into
# deploy/compose.dev.yml, so the stack runs with no .env at all. Copy this
# file to .env only when you need to override something (a port conflict, a
# different password).
#
#   cp .env.example .env
#
# Compose resolves .env relative to the compose file's directory, so pass it
# explicitly when running from the repository root:
#
#   docker compose --env-file .env -f deploy/compose.dev.yml --profile core up -d
#
# These are development credentials in a file that is committed on purpose.
# Nothing here may ever be used outside a local machine.

# ── Application database (profile: core) ────────────────────────────────────
# Host port 5433: 5432 is usually taken by a locally installed Postgres.
NIX_PG_PORT=5433
NIX_PG_DB=nix
NIX_PG_SUPERUSER_PASSWORD=nix-dev-superuser
# Runtime role. Must never hold BYPASSRLS; the seed asserts this.
NIX_PG_APP_PASSWORD=nix-dev-app
# Migration role. Owns the schema and is the only role with BYPASSRLS.
NIX_PG_MIGRATOR_PASSWORD=nix-dev-migrator
# Collaboration role. Reads and writes the content tables and nothing else, and
# like nix_app must never hold BYPASSRLS; the seed asserts this too.
NIX_PG_COLLAB_PASSWORD=nix-dev-collab

# ── Collaboration service (runs on the host, not in compose) ────────────────
# Start with: pnpm --filter @nix/collab dev
# It reaches Postgres directly as nix_collab, and authorizes every session by
# forwarding the caller's own token to Core's /internal surface. The shared
# secret proves which service is calling; the token proves on whose behalf.
NIX_COLLAB_PORT=8100
NIX_COLLAB_DATABASE_URL=postgresql://nix_collab:nix-dev-collab@localhost:5433/nix
NIX_COLLAB_CORE_BASE_URL=http://localhost:5014
# Must match Core's Nix__InternalSecret (set below). Development value only.
NIX_COLLAB_INTERNAL_SECRET=nix-dev-internal
# How often a live socket's authorization is re-checked, in seconds. The bound
# on how long a revoked grant can keep a session alive is roughly twice this.
NIX_COLLAB_REAUTH_SECONDS=60
# Resident-document tuning. The defaults are the design's numbers; override
# them for load experiments, not for production preference.
#NIX_COLLAB_FLUSH_MS=500
#NIX_COLLAB_FLUSH_BYTES=65536
#NIX_COLLAB_SNAPSHOT_EVERY=200
#NIX_COLLAB_SNAPSHOT_INTERVAL_SECONDS=300
#NIX_COLLAB_IDLE_EVICT_SECONDS=300
#NIX_COLLAB_MAX_DOCS=200
#NIX_COLLAB_MAX_RESIDENT_MB=256
NIX_COLLAB_OIDC_ISSUER=http://localhost:8300
# Multi-issuer deployments list them instead, comma-separated, each entry
# either "issuer" or "issuer|jwksUri". Takes precedence over the singular.
#NIX_COLLAB_OIDC_ISSUERS=http://localhost:8300

# Core's half of the internal boundary (read by the API when started from this
# shell): the same value as NIX_COLLAB_INTERNAL_SECRET, or the /internal
# surface answers 404 to everything and the collaboration service cannot open
# a session.
Nix__InternalSecret=nix-dev-internal
# Comma-separated; any one is accepted. Zitadel mints the web client's id as the
# audience for browser tokens and the project's id for machine identities, so
# both belong here. The real values are written to deploy/.zitadel/oidc.generated.env
# by zitadel-configure.sh - NIX_OIDC_CLIENT_ID and NIX_OIDC_PROJECT_ID.
NIX_COLLAB_OIDC_AUDIENCE=<client id>,<project id>

# ── Object storage: Versity S3 gateway (profile: core) ──────────────────────
# Host port 7070 is versitygw's native port (9000 would clash with MinIO).
VERSITY_PORT=7070
VERSITY_ROOT_ACCESS_KEY=nix-dev-access
VERSITY_ROOT_SECRET_KEY=nix-dev-secret-key

# ── Identity provider: Zitadel (profile: core) ──────────────────────────────
# Console:   http://localhost:8300/ui/console
# Discovery: http://localhost:8300/.well-known/openid-configuration
ZITADEL_PORT=8300
# Must be exactly 32 bytes. Zitadel refuses to start otherwise.
ZITADEL_MASTERKEY=NixDevMasterkeyMustBe32BytesOk!!
ZITADEL_DB_ADMIN_PASSWORD=zitadel-dev-admin
ZITADEL_DB_USER_PASSWORD=zitadel-dev-user
# First-instance bootstrap; applies only on the very first initialisation.
ZITADEL_ORG_NAME=nix-dev
ZITADEL_ADMIN_USERNAME=nix-admin
ZITADEL_ADMIN_PASSWORD=NixDev-Password1!
ZITADEL_MACHINE_USERNAME=nix-dev-machine

# ── Telemetry: Aspire dashboard (profile: core) ─────────────────────────────
# UI on 18888; services export OTLP to 18889 (gRPC) or 18890 (HTTP/protobuf).
ASPIRE_DASHBOARD_PORT=18888
ASPIRE_OTLP_GRPC_PORT=18889
ASPIRE_OTLP_HTTP_PORT=18890

# ── Virus scanning: clamd (profile: media) ──────────────────────────────────
# Not in the default profile: needs roughly 1-2 GB RAM and a long first-start
# signature download.
CLAMD_PORT=3310

# ── Mock LLM endpoint (profile: ai) ─────────────────────────────────────────
# Point the AI provider's base URL at http://localhost:8380/api/v1
MOCK_LLM_PORT=8380
