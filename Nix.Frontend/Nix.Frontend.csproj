<!--
  The frontend tree, surfaced inside the .NET solution.

  Nix.slnx sits at the repository root so that one IDE window covers both lanes.
  This project exists only so the frontend sources are browsable from that
  window. It compiles no C#, references nothing, and produces nothing anyone
  consumes - apps/ and packages/ are built by pnpm, never by MSBuild.

  It is a plain SDK project rather than a stub that opts out of restore: a
  project that answers "restore not supported" makes every solution-wide restore
  (so every backend CI run, and dotnet format as well) log NU1503, and that
  warning cannot be silenced from inside the project it names.

  It sits in this subdirectory rather than at the repository root because a root
  holding both Nix.slnx and a .csproj makes an unqualified `dotnet build` or
  `dotnet test` fail with MSB1011, "this folder contains more than one project
  or solution file". With only Nix.slnx left up there the obvious command is the
  right one. Three fixes that look plausible are not:

    - global.json pins the SDK version and has no say in which project or
      solution MSBuild selects.
    - Directory.Build.rsp is worse than useless here, because it appears to
      work: it makes the bare `dotnet build` succeed while breaking the
      explicit invocations CI uses. Its arguments are prepended to every
      command, so `dotnet build Nix.slnx` dies on a duplicate switch and
      `dotnet test <project>` dies with MSB1008.
    - Renaming the extension changes nothing; project discovery matches
      *.*proj generically.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- This directory holds nothing but the project file; every item comes
         from the sibling frontend trees and is listed by hand below. -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <!-- The files live outside this project's directory, so LinkBase rebuilds each
       one's real repository-relative path under the solution explorer. Without
       it they all flatten to the project root, where the many identically named
       index.ts files become indistinguishable.

       `**/*` is already fully recursive. The apps line briefly read
       `src/**/**/**` on the belief that deeper files needed more stars; they do
       not, and the two forms were measured to yield the identical 456 items
       including every file at every depth. One star pattern per line, matching
       the packages line, so nobody has to re-derive that.

       A new sibling directory - a fourth app, a new package - is matched by
       these globs but is NOT picked up by an IDE that already has the project
       loaded: the items live outside this project's own directory, so the file
       watcher scoped to it never sees them appear. Reload the project (Rider:
       right-click the solution, Reload Project) after adding one. This is what
       made apps/media look absent from the solution explorer on the day it was
       added while every command-line tool saw it. -->
  <ItemGroup>
    <None Include="../apps/*/src/**/*" LinkBase="apps" />
    <None Include="../packages/*/src/**/*" LinkBase="packages" />
  </ItemGroup>

</Project>
