{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // Node, not DOM. An archive is written by a service; `TextEncoder` and friends come from the
    // platform this actually runs on rather than from a browser lib nothing here uses.
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
