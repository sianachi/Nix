{
  "schemaVersion": 5,
  "prosemirror": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "I resisted Kubernetes for my side projects for years. Too much machinery for three services. Then I ran three services by hand for a year."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "What changed"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Restarts, rollouts and health checks stopped being scripts I maintained."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Every service declares what it needs in one place."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Moving to a new machine became a matter of pointing the cluster at it."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "codeBlock",
        "attrs": {
          "language": "yaml"
        },
        "content": [
          {
            "type": "text",
            "text": "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: jobbie-api\nspec:\n  replicas: 2"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "It is still too much for a single static site. It is about right for anything with a database and a worker."
          }
        ]
      }
    ]
  }
}
