{
  "schemaVersion": 5,
  "prosemirror": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Scan a home network and you will find at least one device whose web admin page opens straight to the settings. No login, no warning. It is usually something nobody remembers installing."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "Why it keeps happening"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Devices ship with the panel open so setup is easy, and the step that closes it is optional. Optional security steps are skipped steps."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "What to do on your own network"
          }
        ]
      },
      {
        "type": "taskList",
        "content": [
          {
            "type": "taskItem",
            "attrs": {
              "checked": true
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "List every device that answers on port 80 or 443"
                  }
                ]
              }
            ]
          },
          {
            "type": "taskItem",
            "attrs": {
              "checked": true
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Set a password on each admin page"
                  }
                ]
              }
            ]
          },
          {
            "type": "taskItem",
            "attrs": {
              "checked": false
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Move devices onto their own network segment"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "itemBlock",
        "attrs": {
          "targetId": "0199c0de-0200-7000-8000-000000000999",
          "presentation": "embed"
        }
      }
    ]
  }
}
