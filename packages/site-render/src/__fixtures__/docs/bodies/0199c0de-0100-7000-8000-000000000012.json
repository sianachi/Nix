{
  "schemaVersion": 5,
  "prosemirror": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "A workspace is the top of a tree. Everything you make lives somewhere in it, and its members share it."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "Make a few items"
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 1
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Press "
                  },
                  {
                    "type": "text",
                    "text": "N",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " to create an item, and give it a title."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Type "
                  },
                  {
                    "type": "text",
                    "text": "/",
                    "marks": [
                      {
                        "type": "code"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " in its body to add a heading, a checklist or a table."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Drag another item onto it to make it a child."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "Give the children a shape"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Open the item's views and add a "
          },
          {
            "type": "text",
            "text": "board",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": ". Add a "
          },
          {
            "type": "text",
            "text": "Status",
            "marks": [
              {
                "type": "italic"
              }
            ]
          },
          {
            "type": "text",
            "text": " property, and each child becomes a card you can drag between columns. Switch the same view to a "
          },
          {
            "type": "text",
            "text": "calendar",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " and the cards land on their dates."
          }
        ]
      },
      {
        "type": "taskList",
        "content": [
          {
            "type": "taskItem",
            "attrs": {
              "checked": true
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Create a workspace"
                  }
                ]
              }
            ]
          },
          {
            "type": "taskItem",
            "attrs": {
              "checked": true
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add three items"
                  }
                ]
              }
            ]
          },
          {
            "type": "taskItem",
            "attrs": {
              "checked": false
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Add a board view"
                  }
                ]
              }
            ]
          },
          {
            "type": "taskItem",
            "attrs": {
              "checked": false
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Invite someone"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "Where to go next"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Read about "
          },
          {
            "type": "reference",
            "attrs": {
              "targetId": "0199c0de-0100-7000-8000-000000000020",
              "label": "views and properties",
              "kind": "item"
            }
          },
          {
            "type": "text",
            "text": ", or set up "
          },
          {
            "type": "reference",
            "attrs": {
              "targetId": "0199c0de-0100-7000-8000-000000000030",
              "label": "backups",
              "kind": "item"
            }
          },
          {
            "type": "text",
            "text": " before you put anything important in."
          }
        ]
      }
    ]
  }
}
