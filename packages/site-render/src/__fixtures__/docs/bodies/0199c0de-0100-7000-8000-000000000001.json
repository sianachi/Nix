{
  "schemaVersion": 5,
  "prosemirror": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Nix is a self-hosted workspace for running your life and your work in one place. Notes, tasks, tables, canvases, spreadsheets and calendars are not separate apps bolted together. They are all "
          },
          {
            "type": "text",
            "text": "items",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": ", and every item can hold other items."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "That one idea does a lot of work. A project is an item whose children are tasks. A reading list is an item whose children are books, shown as a gallery. A journal is an item whose children are dated entries. Views decide how children are shown; they never change what the children are."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "What you get"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Items and views.",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " Show the same children as a list, board, gallery, calendar, timeline, table or chart."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Canvas and sheets.",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " Draw on an infinite canvas, or work in a spreadsheet with real formulas."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Formulas and rollups.",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " Compute properties from other properties, and roll children up into their parent."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Live collaboration.",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " Edit together in real time, with presence, comments and named versions."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Offline first.",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " Keep working without a connection; changes merge when you are back."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Plugins.",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " Extend Nix with sandboxed plugins that add blocks, views and automations."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "Try it in five minutes"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Nix runs on your own machine or server. If you have Docker, this is enough to start:"
          }
        ]
      },
      {
        "type": "codeBlock",
        "attrs": {
          "language": "bash"
        },
        "content": [
          {
            "type": "text",
            "text": "curl -fsSL https://example.org/nix/compose.yml -o compose.yml\ndocker compose up -d\nopen http://localhost:8080"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Then follow "
          },
          {
            "type": "reference",
            "attrs": {
              "targetId": "0199c0de-0100-7000-8000-000000000011",
              "label": "Install",
              "kind": "item"
            }
          },
          {
            "type": "text",
            "text": " for a production setup, or read "
          },
          {
            "type": "reference",
            "attrs": {
              "targetId": "0199c0de-0100-7000-8000-000000000020",
              "label": "Features",
              "kind": "item"
            }
          },
          {
            "type": "text",
            "text": " for a tour."
          }
        ]
      }
    ]
  }
}
