{
  "schemaVersion": 5,
  "prosemirror": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Nix ships as a small set of container images. One machine with 2 CPU cores and 4 GB of memory comfortably runs a workspace for a household or a small team."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "Requirements"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Docker 24 or later with the Compose plugin"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "A domain name if you want to reach Nix from outside your network"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "About 2 GB of disk to start, plus your files"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "Run with Docker Compose"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Save this as "
          },
          {
            "type": "text",
            "text": "compose.yml",
            "marks": [
              {
                "type": "code"
              }
            ]
          },
          {
            "type": "text",
            "text": ". It runs the app, the database, the object store and the background workers."
          }
        ]
      },
      {
        "type": "codeBlock",
        "attrs": {
          "language": "yaml"
        },
        "content": [
          {
            "type": "text",
            "text": "services:\n  nix:\n    image: ghcr.io/sianachi/nix:latest\n    ports: [\"8080:8080\"]\n    environment:\n      NIX_PUBLIC_URL: https://nix.example.org\n    depends_on: [postgres]\n  postgres:\n    image: postgres:17\n    volumes: [\"db:/var/lib/postgresql/data\"]\nvolumes:\n  db: {}"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Start it, then watch the logs until the app reports that it is ready:"
          }
        ]
      },
      {
        "type": "codeBlock",
        "attrs": {
          "language": "bash"
        },
        "content": [
          {
            "type": "text",
            "text": "docker compose up -d\ndocker compose logs -f nix | grep -m1 \"ready\""
          }
        ]
      },
      {
        "type": "callout",
        "attrs": {
          "tone": "tip"
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Pin the image to a release tag in production. "
              },
              {
                "type": "text",
                "text": "latest",
                "marks": [
                  {
                    "type": "code"
                  }
                ]
              },
              {
                "type": "text",
                "text": " is convenient for trying Nix, not for running it."
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "First sign-in"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Open the address you configured. The first account you create becomes the owner of the first workspace. You can invite others from the workspace settings once you are in."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Signing in from the command line"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "nixctl",
            "marks": [
              {
                "type": "code"
              }
            ]
          },
          {
            "type": "text",
            "text": " talks to the same API as the web app. Sign in once and it remembers the session:"
          }
        ]
      },
      {
        "type": "codeBlock",
        "attrs": {
          "language": "bash"
        },
        "content": [
          {
            "type": "text",
            "text": "nixctl login https://nix.example.org\nnixctl ws list"
          }
        ]
      }
    ]
  }
}
