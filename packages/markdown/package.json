{
  "name": "@nix/markdown",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Markdown for Nix: the body mapping to and from ProseMirror JSON, plus the shared front matter, note-title and unresolved-reference rules every import surface uses",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./front-matter": {
      "types": "./dist/front-matter.d.ts",
      "default": "./dist/front-matter.js"
    },
    "./scan": {
      "types": "./dist/scan.d.ts",
      "default": "./dist/scan.js"
    },
    "./from-markdown": {
      "types": "./dist/from-markdown.d.ts",
      "default": "./dist/from-markdown.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "@nix/editor-schema": "workspace:*",
    "@nix/export": "workspace:*",
    "markdown-it": "^14.1.0",
    "prosemirror-markdown": "^1.13.2",
    "prosemirror-model": "^1.25.11"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
