  "fallbackReply": "Please keep the design simple and ask only what you need to know.",
  "expectations": {
    "mustHave": [
      {
        "kind": "fieldKey",
        "key": "status"
      },
      {
        "kind": "fieldKey",
        "key": "due_date"
      }
    ],
    "mustNot": [],
    "maxItems": 20,
    "preferComputed": ["total_hours"]
  }
}
