    {
      "pattern": "client|project",
      "reply": "One project per client, with tasks beneath it."
    },
    {
      "pattern": "deadline|date",
      "reply": "Track task due dates."
    },
    {
      "pattern": "priority|status",
      "reply": "Use status and priority."
    }
