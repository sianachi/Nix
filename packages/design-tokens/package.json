{
  "name": "@nix/design-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Industry design system token sheet as a Tailwind CSS v4 theme",
  "exports": {
    ".": {
      "style": "./src/theme.css",
      "default": "./src/theme.css"
    },
    "./theme.css": "./src/theme.css",
    "./print": {
      "types": "./dist/print.d.ts",
      "default": "./dist/print.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/theme.css",
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --project tsconfig.build.json"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "@types/node": "^22.15.0",
    "tailwindcss": "^4.1.11",
    "vitest": "^3.2.4"
  }
}
