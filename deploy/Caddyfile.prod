# Nix production edge inside Docker. Cloudflare terminates public TLS and the
# tunnel carries the request to this private HTTP listener.
:8090 {
	root * /srv/nix/web
	encode zstd gzip
	# This stable URL announces each new build to installed clients.
	header /service-worker.js Cache-Control "no-store"

	# Preserve the bucket path and signed Host header for S3 capabilities.
	handle /{$NIX_OBJECT_STORE_BUCKET}/* {
		reverse_proxy nix-versitygw:7070
	}

	handle /api/* {
		reverse_proxy nix-api:8080 {
			flush_interval -1
			# cloudflared is the only public ingress. Preserve its authenticated client
			# address as the sole X-Forwarded-For hop so Core's pre-authentication
			# throttle remains per client instead of becoming global to the tunnel.
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	# Remote MCP (the nixctl tool contract over Streamable HTTP). Bearer tokens only; the service
	# refuses anything without one before it builds a tool server.
	handle /mcp {
		reverse_proxy {$NIX_MCP_UPSTREAM} {
			flush_interval -1
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	# CLI sessions use Core's public PAT exchange, outside the browser BFF routes.
	handle /public/v1/auth/token {
		reverse_proxy nix-api:8080 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	handle /auth/* {
		reverse_proxy nix-api:8080 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	handle_path /collab/* {
		reverse_proxy nix-collab:8100
	}

	handle {
		try_files {path} /index.html
		file_server
	}

	header {
		# Compose requires this to be the same validated origin Core uses when signing browser
		# capabilities. Keeping it as one CSP source prevents an object URL from broadening fetch.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-qzYt63qWJpMm2Kfb4Wr8UDbUtUgweR4Gv4rs133db2w='; style-src 'self' 'unsafe-inline'; img-src 'self' http: https: data: blob:; font-src 'self'; connect-src 'self' {$NIX_OBJECT_STORE_PUBLIC_ORIGIN}; media-src 'self' blob: {$NIX_OBJECT_STORE_PUBLIC_ORIGIN}; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

# Nix sites (ADR-0063): a site hostname routed here reaches this listener with the original Host
# header, and Caddy picks this block over the catch-all above for one label under $NIX_SITES_DOMAIN.
# With NIX_SITES_DEFAULT_LABEL_SUFFIX set (a deployment sharing the domain), only labels ending in
# it are this deployment's; the other deployment's names are refused, never served as the app.
# The sites server sets its own CSP and never a cookie; none of the app's headers apply here.
http://*.{$NIX_SITES_DOMAIN}:8090 {
	@site header_regexp Host (?i)^[a-z0-9-]+{$NIX_SITES_DEFAULT_LABEL_SUFFIX}\.
	handle @site {
		reverse_proxy nix-sites-serve:8400
	}
	respond 421
}
