# Release images: full commit SHAs published by the CI images workflow to
# ghcr.io/sianachi/nix. Set NIX_IMAGE_REGISTRY=localhost/nix only to run images
# built on the host with deploy/compose/build.sh.
# NIX_IMAGE_REGISTRY=ghcr.io/sianachi/nix
# Optional. deploy/compose/release.sh <sha> exports NIX_IMAGE_TAG and NIX_WEB_IMAGE_TAG
# in the shell, which takes precedence over this file, so do not edit them per release.
# The placeholders below only serve direct `docker compose` inspection and checks.
NIX_IMAGE_TAG=replace-with-commit-sha
NIX_WEB_IMAGE_TAG=replace-with-commit-sha
# Optional worker-only release; otherwise follows NIX_IMAGE_TAG.
# NIX_WORKER_IMAGE_TAG=replace-with-commit-sha

# Postgres and application connections. Replace every placeholder.
NIX_PG_SUPERUSER_PASSWORD=replace-me
NIX_PG_MIGRATOR_PASSWORD=replace-me
NIX_MIGRATOR_CONNECTION_STRING=Host=postgres;Port=5432;Database=nix;Username=nix_migrator;Password=replace-me
NIX_CORE_DATABASE_URL=Host=postgres;Port=5432;Database=nix;Username=nix_app;Password=replace-me
NIX_COLLAB_DATABASE_URL=postgresql://nix_collab:replace-me@postgres:5432/nix

# Internal application secrets.
NIX_INTERNAL_SECRET=replace-me
NIX_PUBLIC_FORMS_SIGNING_KEY=replace-me

# The bundled broker uses plaintext AMQP only inside the private Compose network. These five
# credentials are intentionally independent; use URL-safe values because Compose builds the local
# connection URIs from them.
NIX_RABBITMQ_API_PASSWORD=replace-me-api
NIX_RABBITMQ_IMPORT_PASSWORD=replace-me-import
NIX_RABBITMQ_EXPORT_PASSWORD=replace-me-export
NIX_RABBITMQ_INDEX_PASSWORD=replace-me-index
NIX_RABBITMQ_PLUGIN_PASSWORD=replace-me-plugin
NIX_RABBITMQ_CALENDAR_PASSWORD=replace-me-calendar
NIX_RABBITMQ_NOTIFY_PASSWORD=replace-me-notify
# For an externally managed TLS broker, override every role independently. The bundled broker can
# then be disabled in a Compose override without changing application configuration.
# NIX_RABBITMQ_API_URL=amqps://nix-api:replace-me@rabbit.example.com:443/%2Fnix
# NIX_RABBITMQ_IMPORT_URL=amqps://nix-import:replace-me@rabbit.example.com:443/%2Fnix
# NIX_RABBITMQ_EXPORT_URL=amqps://nix-export:replace-me@rabbit.example.com:443/%2Fnix
# NIX_RABBITMQ_INDEX_URL=amqps://nix-index:replace-me@rabbit.example.com:443/%2Fnix
# NIX_RABBITMQ_PLUGIN_URL=amqps://nix-plugin:replace-me@rabbit.example.com:443/%2Fnix
# NIX_RABBITMQ_CALENDAR_URL=amqps://nix-calendar:replace-me@rabbit.example.com:443/%2Fnix

# Two-way calendar sync (ADR-0052). Optional: a provider without a client id and secret is shown as
# unavailable. Register the redirect URIs $NIX_PUBLIC_ORIGIN/auth/calendar/callback/google and
# $NIX_PUBLIC_ORIGIN/auth/calendar/callback/microsoft at the provider. Core keeps the refresh tokens,
# protected with its Data Protection keys (the persisted nix-api-data-protection volume): every
# Core replica must share that key ring. Back it up separately from the database: losing it means
# every calendar connection has to be reconnected, and anyone holding both backups can read the tokens.
# NIX_CALENDAR_GOOGLE_CLIENT_ID=
# NIX_CALENDAR_GOOGLE_CLIENT_SECRET=
# NIX_CALENDAR_MICROSOFT_CLIENT_ID=
# NIX_CALENDAR_MICROSOFT_CLIENT_SECRET=
# NIX_CALENDAR_MICROSOFT_TENANT=common

# Calendar sync worker egress origins (defaults shown; override only for testing against fakes).
# NIX_CALENDAR_GOOGLE_ORIGIN=https://www.googleapis.com
# NIX_CALENDAR_MICROSOFT_ORIGIN=https://graph.microsoft.com
# NIX_RABBITMQ_NOTIFY_URL=amqps://nix-notify:replace-me@rabbit.example.com:443/%2Fnix

# Web Push (RFC 8291/8292). Generate one P-256 key pair for the deployment's lifetime; the
# private key (32 raw bytes, base64url, no padding) goes here and to the notify worker only. The
# matching public key (SEC1 uncompressed point, base64url) goes to Core's Nix:Push:VapidPublicKey
# config, which serves it from GET /api/v1/me/push/public-key. Subject is a mailto: or https:
# contact URI push services may use to reach the deployment operator (RFC 8292 section 2.1).
NIX_PUSH_VAPID_PRIVATE_KEY=replace-me
NIX_PUSH_VAPID_PUBLIC_KEY=replace-me-public-key
NIX_PUSH_VAPID_SUBJECT=mailto:replace-me@example.com

# S3-compatible worker staging. The endpoint must be reachable by Core and all Go workers; the
# public origin is the browser-reachable origin used in presigned capabilities and CSP.
NIX_OBJECT_STORE_ENDPOINT=https://nix.urutech.org
NIX_OBJECT_STORE_PUBLIC_ORIGIN=https://nix.urutech.org
NIX_OBJECT_STORE_REGION=us-east-1
NIX_OBJECT_STORE_BUCKET=nix-worker-jobs
NIX_OBJECT_STORE_ACCESS_KEY=replace-me
NIX_OBJECT_STORE_SECRET_KEY=replace-me

# Public OIDC deployment.
NIX_OIDC_ISSUER=https://sso.urutech.org
NIX_OIDC_CLIENT_ID=388309816696635394
# Optional: the IdP self-service account page. Defaults to $NIX_OIDC_ISSUER/ui/console/users/me?id=security.
# NIX_OIDC_ACCOUNT_URL=
NIX_PUBLIC_ORIGIN=https://nix.urutech.org

# Core-signed ten-minute browser/PAT sessions. Generate the P-256 key once and preserve it:
#   openssl ecparam -name prime256v1 -genkey -noout -out ./core-access-token.pem
NIX_CORE_TOKEN_ISSUER=https://nix.urutech.org
NIX_CORE_TOKEN_AUDIENCE=nix
NIX_CORE_TOKEN_KEY_ID=nix-core-2026-08
NIX_CORE_TOKEN_SIGNING_KEY_FILE=./core-access-token.pem

# Remotely managed Cloudflare Tunnel token.
CLOUDFLARE_TUNNEL_TOKEN=replace-me

# Separate migration credential; never passed to the running collaboration service.
NIX_COLLAB_MIGRATOR_CONNECTION_STRING=postgresql://nix_migrator:replace-me@postgres:5432/nix

# Observability. Grafana binds to localhost only, so reach it through SSH port
# forwarding or a separately authenticated operator route; do not add it to the
# public Cloudflare tunnel. Rotate this password independently of app secrets.
NIX_GRAFANA_ADMIN_USER=admin
NIX_GRAFANA_ADMIN_PASSWORD=replace-me
NIX_GRAFANA_PORT=3000
# Pin these on upgrades after validating the release notes in a non-production stack.
NIX_LOKI_IMAGE_TAG=3.5.5
NIX_ALLOY_IMAGE_TAG=v1.11.3
NIX_GRAFANA_IMAGE_TAG=12.2.0
