# Image versions imported or built on the deployment host.
NIX_IMAGE_TAG=8dbe570
NIX_WEB_IMAGE_TAG=cloudflare-oidc-388309816696635394

# Postgres and application connections. Replace every placeholder.
NIX_PG_SUPERUSER_PASSWORD=replace-me
NIX_CORE_DATABASE_URL=Host=postgres;Port=5432;Database=nix;Username=nix_app;Password=replace-me
NIX_COLLAB_DATABASE_URL=postgresql://nix_collab:replace-me@postgres:5432/nix

# Internal application secrets.
NIX_INTERNAL_SECRET=replace-me
NIX_PUBLIC_FORMS_SIGNING_KEY=replace-me

# Public OIDC deployment.
NIX_OIDC_ISSUER=https://sso.urutech.org
NIX_OIDC_CLIENT_ID=388309816696635394
NIX_PUBLIC_ORIGIN=https://nix.urutech.org

# Core-signed ten-minute browser/PAT sessions. Generate the P-256 key once and preserve it:
#   openssl ecparam -name prime256v1 -genkey -noout -out ./core-access-token.pem
NIX_CORE_TOKEN_ISSUER=https://nix.urutech.org
NIX_CORE_TOKEN_AUDIENCE=nix
NIX_CORE_TOKEN_KEY_ID=nix-core-2026-08
NIX_CORE_TOKEN_SIGNING_KEY_FILE=./core-access-token.pem

# Remotely managed Cloudflare Tunnel token.
CLOUDFLARE_TUNNEL_TOKEN=replace-me
