# k3s deployment Caddyfile. Loaded into the nix-caddy ConfigMap by deploy/k8s/deploy.sh and
# mounted into the nix-web pod at /etc/caddy/Caddyfile.
#
# Differs from deploy/Caddyfile (the dev-adjacent reference copy) in three ways: service DNS
# instead of localhost, a /media handler (apps/web/src/export/export-formats.ts routes PDF
# and DOCX exports at /media - without this handler both formats 404), and HSTS enabled
# (only safe because this deployment is HTTPS-only behind the Ingress in deploy/k8s/ingress.yaml).
#
# The CSP here must stay in step with the meta tag in apps/web/index.html, including the
# script hash covering the inline theme script - change one without the other and you have
# two policies. Provider communication is server-side through Core.
:8090 {
	root * /srv/nix/web
	encode zstd gzip

	# Core keeps its /api prefix - its routes are already under /api/v1.
	handle /api/* {
		reverse_proxy nix-api:8080
	}

	handle /auth/* {
		reverse_proxy nix-api:8080
	}

	# Collab's own routes are /documents/...; the prefix is stripped.
	# WebSocket upgrades proxy transparently.
	# This also exposes service routes; Collab's internal-secret check is the boundary.
	handle_path /collab/* {
		reverse_proxy nix-collab:8100
	}

	# Media, same shape.
	handle_path /media/* {
		reverse_proxy nix-media:8200
	}

	handle {
		try_files {path} /index.html
		file_server
	}

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-qzYt63qWJpMm2Kfb4Wr8UDbUtUgweR4Gv4rs133db2w='; style-src 'self' 'unsafe-inline'; img-src 'self' http: https: data:; font-src 'self'; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
