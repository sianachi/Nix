{
  "name": "nix-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "pnpm --filter @nix/editor-schema --filter @nix/api-client --filter @nix/sheet --filter @nix/export --filter @nix/design-tokens --filter @nix/pdf-export --filter @nix/docx-export --filter @nix/view-render --filter @nix/markdown build",
    "bootstrap": "pnpm run prepare",
    "lint": "pnpm -r --if-present lint && pnpm run lint:format",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "dev:collab": "bash scripts/dev-collab.sh",
    "dev:media": "bash scripts/dev-media.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "eslint": "^9.31.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.38.0"
  }
}
