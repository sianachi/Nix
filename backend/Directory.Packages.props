<Project>

  <!-- Central package management: every package version in the backend is pinned here, nowhere else. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <!-- G6a: API vertical slice (minimal APIs, OpenAPI contract, WebApplicationFactory tests).
       Pinned to 10.0.0 to match the ASP.NET Core shared framework the pinned SDK ships;
       the host rolls forward to newer 10.0.x runtimes automatically. -->
  <ItemGroup Label="Api">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <!-- Transitive of Microsoft.AspNetCore.OpenApi, lifted to a direct reference in
         Nix.Api.csproj: the 2.0.0 that 10.0.0 resolves to carries GHSA-v5pm-xwqc-g5wc
         (high), patched in 2.7.5. Drop the direct reference once an ASP.NET Core
         10.0.x floors it above the advisory. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

</Project>
