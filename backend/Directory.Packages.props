<Project>

  <!-- Central package management: every package version in the backend is pinned here, nowhere else. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <!-- G6a: API vertical slice (minimal APIs, OpenAPI contract, WebApplicationFactory tests).
       Pinned to 10.0.0 to match the ASP.NET Core shared framework the pinned SDK ships;
       the host rolls forward to newer 10.0.x runtimes automatically. -->
  <ItemGroup Label="Api">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <!-- Transitive of Microsoft.AspNetCore.OpenApi, lifted to a direct reference in
         Nix.Api.csproj: the 2.0.0 that 10.0.0 resolves to carries GHSA-v5pm-xwqc-g5wc
         (high), patched in 2.7.5. Drop the direct reference once an ASP.NET Core
         10.0.x floors it above the advisory. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

  <!-- ==========================================================================
       G7a - Persistence (EF Core + Npgsql, migration runner, integration harness)

       Appended as a distinct trailing group on purpose: this file is edited by
       more than one branch at a time, and a trailing block merges cleanly.

       Version constraint worth knowing: Npgsql.EntityFrameworkCore.PostgreSQL
       10.0.3 requires Microsoft.EntityFrameworkCore[.Relational] >= 10.0.4, so
       the EF Core versions below must never be lowered past that floor.
       ========================================================================== -->
  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!-- G8 - authentication. Multi-issuer JWT validation; the issuer is resolved per request from
       identity_provider rather than configured, so the handler is configured with a dynamic
       configuration manager rather than a fixed authority. -->
  <ItemGroup Label="Authentication">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Migration runner host">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <!--
    Time, in the domain.

    NodaTime is the one third-party dependency Nix.Core carries. The rule it bends says Core
    references only the BCL, and the rule's purpose is to keep infrastructure - databases, HTTP,
    ORMs - out of the domain. NodaTime is none of those: it is value types and a bundled tz
    database, with no I/O. A domain that models time badly to keep a dependency count at zero has
    the rule backwards. See ADR-0012.

    Npgsql.NodaTime is deliberately absent. Timestamps live inside the properties jsonb blob as
    text, so Npgsql never sees a NodaTime type and its type-mapping plugin would map nothing.
  -->
  <ItemGroup Label="Time">
    <PackageVersion Include="NodaTime" Version="3.3.3" />
  </ItemGroup>

  <ItemGroup Label="Integration test harness">
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
  </ItemGroup>

</Project>
