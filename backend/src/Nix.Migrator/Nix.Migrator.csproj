<Project Sdk="Microsoft.NET.Sdk">

  <!-- The migration job. Runs as nix_migrator, as a Kubernetes Job before the rollout;
       never in-process with the API. See NixMigrationRunner for the rationale. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Nix.Migrator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nix.Infrastructure\Nix.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Design-time only: enables `dotnet ef migrations add` with this project as the
         startup project. Not deployed. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
