<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Nix.Application\Nix.Application.csproj" />
  </ItemGroup>

  <!-- EF Core and Npgsql live here and nowhere else. Nix.Core and Nix.Application
       must never gain a reference to either; the dependency-direction guard tests
       fail the build if they do. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
