root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,sln}]
indent_size = 4

[*.cs]
# Style conventions enforced in build (EnforceCodeStyleInBuild)
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:error
dotnet_style_require_accessibility_modifiers = always:error
dotnet_sort_system_directives_first = true

# Naming: interfaces prefixed with I
dotnet_naming_rule.interfaces_begin_with_i.severity = error
dotnet_naming_rule.interfaces_begin_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_begin_with_i.style = prefix_i
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

[*.{ts,tsx,js,jsx,json,yml,yaml,css}]
indent_size = 2

[Makefile]
indent_style = tab

# CA1716 rejects namespaces that collide with a reserved word in another .NET
# language; "Me" is Visual Basic's `this`. The rule started firing here only when
# the backend collapsed into one assembly and GetCurrentPrincipal became a public
# type in this namespace - the folder and namespace predate that and mirror the
# published route /api/v1/me.
#
# Justification: scoped to this one folder rather than suppressed project-wide,
# so the rule still catches a genuinely awkward namespace elsewhere. Nix has no
# Visual Basic consumer and no plan for one; the only generated client is
# TypeScript, built from backend/openapi/nix-api.json. Renaming the namespace
# away from the route it serves would cost more clarity than the rule buys.
[backend/src/Nix.Api/Features/Me/*.cs]
dotnet_diagnostic.CA1716.severity = none
